<?xml version="1.0" encoding="UTF-8"?>
<!--
    Le dice a NetBeans como ejecutar este proyecto Spring Boot. Sin este
    archivo, NetBeans intenta correrlo con "exec-maven-plugin" y falla con
    "Could not find or load main class ${start-class}", porque esa
    propiedad la define el plugin de Spring Boot mas adelante en el ciclo
    de build de lo que NetBeans llega a ejecutar por defecto.
-->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
